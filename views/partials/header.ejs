<% if (currentPage === "cart") { %>
<header>
  <a href="/" class="header-logo">Corte Fino</a>
  <a href="/" class="btn-voltar">← Continuar comprando</a>
</header>
<script>
  // a pagina do carrinho atualiza o proprio resumo; aqui so evita erro de chamada
  window.atualizarContadorCarrinho = function () {};
</script>
<% } else { %>
<div class="header-top py-2">
  <div class="container d-flex justify-content-end gap-3">
    <span><i class="fas fa-phone"></i> (18) 4002-8922</span>
    <span class="divisor">|</span>
    <span><i class="fa-solid fa-clock"></i> Seg-Sab: 7h-19h | Dom: 7h-13h</span>
  </div>
</div>

<nav class="navbar navbar-expand-lg main-header sticky-top">
  <div class="container">
    <a class="navbar-brand logo-area" href="/">
      <img src="/images/logo-c-f.png" alt="Logo Corte Fino" />
      <span class="fs-3 fw-semibold">Corte Fino</span>
    </a>
    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#menuPrincipal"
      aria-controls="menuPrincipal"
      aria-expanded="false"
      aria-label="Abrir menu"
    >
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="menuPrincipal">
      <ul class="nav nav-pills ms-auto">
        <li class="nav-item">
          <a href="/" class="nav-link <%= currentPage === 'index' ? 'active' : '' %>">Início</a>
        </li>
        <li class="nav-item">
          <a href="/products" class="nav-link <%= currentPage === 'products' ? 'active' : '' %>">Produtos</a>
        </li>
        <li class="nav-item">
          <a href="/offers" class="nav-link <%= currentPage === 'offers' ? 'active' : '' %>">Ofertas</a>
        </li>
        <li class="nav-item">
          <a href="/about" class="nav-link <%= currentPage === 'about' ? 'active' : '' %>">Sobre Nós</a>
        </li>
        <li class="nav-item">
          <a href="/services" class="nav-link <%= currentPage === 'services' ? 'active' : '' %>">Serviços</a>
        </li>
        <li class="nav-item">
          <a href="/contact" class="nav-link <%= currentPage === 'contact' ? 'active' : '' %>">Contato</a>
        </li>
        <li class="nav-item">
          <a href="/signatures" class="nav-link <%= currentPage === 'signatures' ? 'active' : '' %>">Assinaturas</a>
        </li>
        <li class="nav-item">
          <a href="/cart" class="nav-link <%= currentPage === 'cart' ? 'active' : '' %>">
            Carrinho <span class="contador-carrinho" id="contadorCarrinho" hidden>0</span>
          </a>
        </li>
        <li class="nav-item d-flex align-items-center" id="menuUsuario" hidden>
          <span class="nav-link destaque-vermelho usuario-logado" id="nomeUsuario">
            <i class="fa-solid fa-user"></i> <span id="primeiroNome"></span>
          </span>
          <a href="#" class="nav-link link-sair" id="btnSair">Sair</a>
        </li>
        <li class="nav-item" id="menuEntrar">
          <a href="/join" class="nav-link destaque-vermelho <%= currentPage === 'join' || currentPage === 'cadastro' || currentPage === 'adm' ? 'active' : '' %>">Entrar</a>
        </li>
      </ul>
    </div>
  </div>
</nav>
<script>
  // mostra no header quantos itens (soma das quantidades) estao no carrinho
  window.atualizarContadorCarrinho = function () {
    var contador = document.getElementById("contadorCarrinho");
    if (!contador) return;
    var total = 0;
    try {
      var itens = JSON.parse(localStorage.getItem("carrinho_corte_fino")) || [];
      total = itens.reduce(function (soma, item) {
        return soma + (item.quantidade || 0);
      }, 0);
    } catch (e) {}
    contador.textContent = total;
    contador.hidden = total === 0;
  };
  window.atualizarContadorCarrinho();

  //mostra o nome do usuario logado (guardado no login pelo join.js)
  let usuarioSalvo = localStorage.getItem("usuario_corte_fino");
  if (usuarioSalvo != null) {
    let usuario = JSON.parse(usuarioSalvo);
    document.querySelector("#primeiroNome").textContent = usuario.nome.split(" ")[0];
    document.querySelector("#nomeUsuario").title = usuario.nome;
    document.querySelector("#menuUsuario").hidden = false;
    document.querySelector("#menuEntrar").hidden = true;
  }

  document.querySelector("#btnSair").addEventListener("click", sair);

  function sair(e) {
    e.preventDefault();
    localStorage.removeItem("usuario_corte_fino");
    window.location.href = "/";
  }


</script>
<% } %>