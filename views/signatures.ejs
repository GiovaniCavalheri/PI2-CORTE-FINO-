<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte Fino - Açougue Gourmet</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link rel="shortcut icon" href="/images/icon-Corte-Fino.ico" />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
      rel="stylesheet"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />


    <link rel="stylesheet" href="/CSS/style.css" />
  </head>

  <body>
    <%- include("partials/header", { currentPage: "signatures" }) %>


    <section class="offers">
      <div class="container">
        <span class="subtitle-premium">Clube de Benefícios</span>
        <h2>Assinaturas Premium</h2>
        <p class="section-description">
          Escolha a seleção perfeita de cortes nobres para a sua rotina ou para
          o churrasco do final de semana.
        </p>

        <div class="offers-grid mt-5">
          <div class="offers-card">
            <div class="img-container">
              <img
                src="/images/signatures/PLANOBASIC.jpg"
                alt="Assinatura Básica"
              />
            </div>
            <h3>Assinatura Básica</h3>
            <div class="descricao-oferta">
              <span class="label-inclui">O que inclui:</span>
              <ul>
                <li>Carne moída</li>
                <li>Frango (coxas/sobrecoxas ou peito)</li>
                <li>Bife bovino simples (acém, paleta)</li>
                <li>Linguiça tradicional</li>
              </ul>
              <div class="diferencial-tag">
                <strong>Diferencial:</strong> Preço acessível, praticidade para
                o dia a dia.
              </div>
            </div>
            <div class="price-container">
              <p class="antigo">R$ 799,99</p>
              <p class="novo">R$ 599,99</p>
            </div>
            <a
              href="https://wa.me/5518997732006?text=Olá%20Corte%20Fino,%20gostaria%20de%20solicitar%20atendimento%20para%20a%20oferta%20da%20Plano%20Básico."
              class="w-100 text-decoration-none"
            >
              <button type="button" class="button-orçamento w-100">
                Solicitar Atendimento
              </button>
            </a>
          </div>

          <div class="offers-card featured-card">
            <div class="img-container">
              <img
                src="/images/signatures/planopremium.jpg"
                alt="Assinatura Churrasco Premium"
              />
            </div>
            <h3>Churrasco Premium</h3>
            <div class="descricao-oferta">
              <span class="label-inclui">O que inclui:</span>
              <ul>
                <li>Picanha Selecionada</li>
                <li>Fraldinha ou Bife Ancho</li>
                <li>Costela Bovina</li>
                <li>Linguiça especial artesanal</li>
                <li class="opcional-text">
                  (Opcional: carvão e temperos da casa)
                </li>
              </ul>
              <div class="diferencial-tag">
                <strong>Diferencial:</strong> Cortes nobres selecionados,
                experiência gourmet e entrega prioritária.
              </div>
            </div>
            <div class="price-container">
              <p class="antigo">R$ 2.299,99</p>
              <p class="novo">R$ 1.999,99</p>
            </div>
            <a
              href="https://wa.me/5518997732006?text=Olá%20Corte%20Fino,%20gostaria%20de%20solicitar%20atendimento%20para%20a%20oferta%20do%20Plano%20Premium."
              class="w-100 text-decoration-none"
            >
              <button type="button" class="button-orçamento w-100">
                Solicitar Atendimento
              </button>
            </a>
          </div>

          <div class="offers-card">
            <div class="img-container">
              <img
                src="/images/signatures/planofit.jpg"
                alt="Assinatura Fitness"
              />
            </div>
            <h3>Assinatura Fitness</h3>
            <div class="descricao-oferta">
              <span class="label-inclui">O que inclui:</span>
              <ul>
                <li>Peito de frango limpo</li>
                <li>Patinho moído de primeira</li>
                <li>Carne bovina magra (coxão mole, alcatra)</li>
                <li>Filé de Tilápia (opcional)</li>
              </ul>
              <div class="diferencial-tag">
                <strong>Diferencial:</strong> Foco em alta proteína, cortes
                estritamente magros e porcionados.
              </div>
            </div>
            <div class="price-container">
              <p class="antigo">R$ 999,99</p>
              <p class="novo">R$ 799,99</p>
            </div>
            <a
              href="https://wa.me/5518997732006?text=Olá%20Corte%20Fino,%20gostaria%20de%20solicitar%20atendimento%20para%20a%20oferta%20do%20Plano%20Fitness."
              class="w-100 text-decoration-none"
            >
              <button type="button" class="button-orçamento w-100">
                Solicitar Atendimento
              </button>
            </a>
          </div>
        </div>
      </div>
    </section>

    <%- include("partials/footer", { footerType: "signatures" }) %>

    <script src="/JS/scripts/products.js" defer></script>
  </body>
</html>
