<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte Fino - Açougue Gourmet</title>
    <link
      rel="shortcut icon"
      href="/images/icon-Corte-Fino.ico"
      type="image/x-icon"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/CSS/style.css" />
  </head>



  <body>
    <%- include("partials/header", { currentPage: "index" }) %>
    <!-- SEÇÃO HERO -->
    <section class="hero-section-index d-flex align-items-center">
      <div class="container py-5 px-4 px-md-5">
        <h4 class="border-premium">Qualidade Premium</h4>
        <h2 class="h1 mb-3 text-white fw-bold">
          Qualidade e Frescor que sua mesa merece
        </h2>
        <p class="sub-hero col-12 col-md-7">
          Carnes nobres selecionadas, cortes especiais e atendimento de
          excelência. Tradição e qualidade desde 1995.
        </p>
        <div class="d-flex flex-column flex-sm-row gap-3 mt-4">
          <a href="/products">
            <button class="btn-cf-primary w-100">
              Ver Catálogo Completo <i class="fa-solid fa-arrow-right"></i>
            </button>
          </a>
          <a href="/offers">
            <button class="btn-cf-secondary w-100">
              Ver Ofertas da Semana
            </button>
          </a>
        </div>
      </div>
    </section>

    <!-- SEÇÃO BENEFÍCIOS -->
    <section class="benefits-section py-5">
      <div class="container">
        <div class="row g-4 justify-content-center">
          <div class="col-12 col-md-4 col-lg-3">
            <div class="benefit-card text-center">
              <div class="beneficio-icone mx-auto mb-3">
                <i class="fa-solid fa-medal"></i>
              </div>
              <h2 class="fs-5">Qualidade Certificada</h2>
              <p>Carnes selecionadas com certificação de origem e qualidade.</p>
            </div>
          </div>
          <div class="col-12 col-md-4 col-lg-3">
            <div class="benefit-card text-center">
              <div class="beneficio-icone mx-auto mb-3">
                <i class="fa-solid fa-truck"></i>
              </div>
              <h2 class="fs-5">Entrega Rápida</h2>
              <p>Entregamos em toda região com refrigeração adequada</p>
            </div>
          </div>
          <div class="col-12 col-md-4 col-lg-3">
            <div class="benefit-card text-center">
              <div class="beneficio-icone mx-auto mb-3">
                <i class="ri-restaurant-line"></i>
              </div>
              <h2 class="fs-5">Cortes Especiais</h2>
              <p>Açougueiros experientes para cortes especializados</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SESSÃO DESTAQUES -->
    <section class="highlights-of-the-week py-5">
      <div class="container">
        <h2 class="text-center fw-bold mb-2" style="color: #2e1a16">
          Destaques da Semana
        </h2>

        <p class="sub-high text-center mb-5">
          Cortes selecionados para uma experiência premium
        </p>
        <div class="row g-4 justify-space-evenly">
          <!-- CARD 1 -->
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card-produto h-100">
              <div class="badge-card">Mais Vendido</div>

              <img
                src="/images/Cards-Produtos/picanha-bovina-card.png"
                alt="Picanha Premium"
              />
              <h3>Picanha Premium</h3>
              <p>
                Picanha Argentina maturada por 21 dias, extremamente macia e
                suculenta.
              </p>

              <div class="info-carne">
                <span>Angus Certificado</span>
                <span>Ideal para churrasco premium</span>
                <span>Oferta válida até sábado</span>
              </div>

              <div class="preco-card">
                <span class="preco-antigo"> R$ 119,90/kg </span>

                <span class="preco-novo"> R$ 89,90 </span>
              </div>

              <a
                href="https://wa.me/5518997732006?text=Olá%20Corte%20Fino,%20tenho%20interesse%20na%20Picanha%20Premium."
                target="_blank"
              >
                <button class="button-orçamento w-100">
                  Pedir no WhatsApp
                </button>
              </a>
            </div>
          </div>

          <!-- CARD 2 -->
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card-produto h-100">
              <div class="badge-card">Escolha Recomendada</div>

              <img
                src="/images/Cards-Produtos/file-mignon-card.png"
                alt="Filé Mignon"
              />
              <h3>Filé Mignon Prime</h3>
              <p>
                Corte nobre extremamente macio, com sabor refinado e textura
                amanteigada.
              </p>

              <div class="info-carne">
                <span>Corte Premium Selecionado</span>
                <span>Ideal para harmonização</span>
                <span>Maciez excepcional</span>
              </div>

              <div class="preco-card">
                <span class="preco-antigo"> R$ 149,90/kg </span>

                <span class="preco-novo"> R$ 119,90 </span>
              </div>

              <a
                href="https://wa.me/5518997732006?text=Olá%20Corte%20Fino,%20tenho%20interesse%20no%20Filé%20Mignon%20Prime."
                target="_blank"
              >
                <button class="button-orçamento w-100">Reservar Corte</button>
              </a>
            </div>
          </div>
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card-produto h-100">
              <div class="badge-card">Escolha Recomendada</div>

              <img
                src="/images/Cards-Produtos/card-costela.png"
                alt="Filé Mignon"
              />
              <h3>Costela Bovina</h3>
              <p>Costela Maturada Suculenta, com sabor defumado.</p>

              <div class="info-carne">
                <span>Corte Premium Selecionado</span>
                <span>Ideal para dividir com a família</span>
                <span>Maciez surpreendente</span>
              </div>

              <div class="preco-card">
                <span class="preco-antigo"> R$ 59,90/kg </span>

                <span class="preco-novo"> R$ 39,90 </span>
              </div>

              <a
                href="https://wa.me/5518997732006?text=Olá%20Corte%20Fino,%20tenho%20interesse%20no%20Filé%20Mignon%20Prime."
                target="_blank"
              >
                <button class="button-orçamento w-100">Reservar Corte</button>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SESSÃO EVENTOS -->
    <section class="events py-5">
      <div class="container text-center py-4">
        <i class="fa-solid fa-people-group peoples-styling mb-3"></i>
        <h2 class="events-h2">Atendimento para Eventos</h2>
        <p class="events-p col-12 col-md-6 mx-auto">
          Churrascos, festas e eventos corporativos. Oferecemos kits especiais e
          atendimento personalizado para o seu evento.
        </p>
        <a href="/services">
          <button class="btn-events px-4 py-2">Saiba Mais</button>
        </a>
      </div>
    </section>

    <!-- RODAPÉ -->
    <%- include("partials/footer", { footerType: "default" }) %>


  </body>
</html>
