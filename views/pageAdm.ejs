<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte Fino — Painel Admin</title>
    <link
      rel="shortcut icon"
      href="/images/icon-Corte-Fino.ico"
      type="image/x-icon"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #e0d2c1;
        --bg2: #fdf0df;
        --bg3: #e9dfd6;
        --surface: #e0cab3;
        --border: #d0b89a;
        --red: #87353a;
        --red-dark: #91454a;
        --red-light: #ad4c52;
        --gold: #8a6245;
        --gold-light: #a07855;
        --text: #2e1a16;
        --muted: #7a6255;
        --sidebar-w: 260px;
        --topbar-h: 64px;
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        font-family: "Poppins", sans-serif;
        background: var(--bg);
        color: var(--text);
        display: flex;
        min-height: 100vh;
        font-size: 14px;
      }

      /* ── SIDEBAR ── */
      #sidebar {
        width: var(--sidebar-w);
        background: var(--bg2);
        border-right: 1px solid var(--border);
        display: flex;
        flex-direction: column;
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        z-index: 200;
        transition: transform 0.3s ease;
      }

      #sidebar.collapsed {
        transform: translateX(calc(-1 * var(--sidebar-w)));
      }

      .sidebar-brand {
        padding: 24px 20px 20px;
        border-bottom: 1px solid var(--border);
      }

      .brand-logo {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 6px;
      }

      .brand-icon {
        width: 36px;
        height: 36px;
        background: var(--red);
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
      }

      .brand-name {
        font-family: "Playfair Display", serif;
        font-size: 18px;
        font-weight: 700;
        color: var(--text);
        line-height: 1.2;
      }

      .brand-sub {
        font-size: 11px;
        color: var(--muted);
        letter-spacing: 0.08em;
        text-transform: uppercase;
        margin-left: 46px;
      }

      .sidebar-nav {
        flex: 1;
        padding: 16px 12px;
        overflow-y: auto;
      }

      .nav-label {
        font-size: 10px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        padding: 10px 8px 6px;
      }

      .nav-link-cf {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 8px;
        color: var(--muted);
        text-decoration: none;
        font-size: 13.5px;
        font-weight: 400;
        transition:
          background 0.15s,
          color 0.15s;
        margin-bottom: 2px;
        cursor: pointer;
      }

      .nav-link-cf i {
        width: 18px;
        text-align: center;
        font-size: 15px;
      }

      .nav-link-cf:hover {
        background: var(--bg3);
        color: var(--text);
      }

      .nav-link-cf.active {
        background: rgba(133, 52, 57, 0.13);
        color: var(--red-dark);
        font-weight: 500;
      }

      .nav-link-cf.active i {
        color: var(--red-dark);
      }

      .sidebar-footer {
        padding: 16px 20px;
        border-top: 1px solid var(--border);
      }

      .sidebar-footer a {
        color: var(--muted);
        text-decoration: none;
        font-size: 13px;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: color 0.15s;
      }

      .sidebar-footer a:hover {
        color: var(--text);
      }

      /* ── MAIN ── */
      #main {
        margin-left: var(--sidebar-w);
        flex: 1;
        min-height: 100vh;
        transition: margin-left 0.3s ease;
      }

      #main.expanded {
        margin-left: 0;
      }

      /* ── TOPBAR ── */
      .topbar {
        height: var(--topbar-h);
        background: var(--bg2);
        border-bottom: 1px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        position: sticky;
        top: 0;
        z-index: 100;
      }

      .btn-toggle {
        background: none;
        border: 1px solid var(--border);
        color: var(--muted);
        width: 36px;
        height: 36px;
        border-radius: 8px;
        cursor: pointer;
        font-size: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition:
          border-color 0.15s,
          color 0.15s;
      }

      .btn-toggle:hover {
        border-color: var(--red);
        color: var(--red-dark);
      }

      .topbar-title {
        font-family: "Playfair Display", serif;
        font-size: 20px;
        font-weight: 600;
        color: var(--text);
        margin-left: 12px;
      }

      .topbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--red);
        color: #fff;
        font-size: 13px;
        font-weight: 600;
        display: flex;
        align-items: center;
        justify-content: center;
        letter-spacing: 0.04em;
      }

      .topbar-badge {
        background: var(--surface);
        border: 1px solid var(--border);
        color: var(--muted);
        font-size: 12px;
        padding: 4px 12px;
        border-radius: 20px;
      }

      /* ── CONTENT ── */
      .page-content {
        display: none;
        padding: 28px 28px 40px;
      }
      .page-content.active {
        display: block;
      }

      /* ── CARDS ── */
      .stat-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 16px;
        margin-bottom: 28px;
      }

      .stat-card {
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
        overflow: hidden;
      }

      .stat-card::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 3px;
        height: 100%;
        background: var(--red);
      }

      .stat-icon {
        width: 42px;
        height: 42px;
        background: rgba(133, 52, 57, 0.15);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--red-dark);
        font-size: 18px;
        flex-shrink: 0;
      }

      .stat-value {
        font-family: "Playfair Display", serif;
        font-size: 26px;
        font-weight: 700;
        color: var(--text);
        line-height: 1;
      }

      .stat-label {
        font-size: 12px;
        color: var(--muted);
        margin-top: 3px;
      }

      .form-card {
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 22px 24px;
        margin-bottom: 24px;
      }

      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
      }

      .section-title {
        font-family: "Playfair Display", serif;
        font-size: 18px;
        font-weight: 600;
        color: var(--text);
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .section-title i {
        color: var(--red);
        font-size: 16px;
      }

      /* ── FORM ELEMENTS ── */
      label.form-label {
        display: block;
        font-size: 12px;
        font-weight: 500;
        color: var(--muted);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-bottom: 6px;
      }

      input[type="text"],
      input[type="number"],
      textarea,
      select {
        width: 100%;
        background: var(--bg3);
        border: 1px solid var(--border);
        border-radius: 8px;
        color: var(--text);
        padding: 10px 14px;
        font-family: "Poppins", sans-serif;
        font-size: 14px;
        outline: none;
        transition: border-color 0.2s;
      }

      input:focus,
      textarea:focus,
      select:focus {
        border-color: var(--red);
      }

      input.campo-invalido {
        border-color: var(--red) !important;
        background: rgba(135, 53, 58, 0.06);
      }

      .msg-erro-campo {
        font-size: 11px;
        color: var(--red);
        margin-top: 4px;
        display: none;
      }

      .msg-erro-campo.show {
        display: block;
      }

      select option {
        background: var(--bg3);
      }

      .form-row {
        display: grid;
        gap: 16px;
        margin-bottom: 16px;
      }

      .form-row.cols-2 {
        grid-template-columns: 1fr 1fr;
      }
      .form-row.cols-3 {
        grid-template-columns: 1fr 1fr 1fr;
      }

      @media (max-width: 640px) {
        .form-row.cols-2,
        .form-row.cols-3 {
          grid-template-columns: 1fr;
        }
      }

      /* ── BUTTONS ── */
      .btn-red {
        background: var(--red);
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-family: "Poppins", sans-serif;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition:
          background 0.15s,
          transform 0.1s;
      }

      .btn-red:hover {
        background: var(--red-dark);
      }
      .btn-red:active {
        transform: scale(0.97);
      }

      .btn-outline {
        background: transparent;
        color: var(--muted);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 10px 20px;
        font-family: "Poppins", sans-serif;
        font-size: 14px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition:
          border-color 0.15s,
          color 0.15s;
      }

      .btn-outline:hover {
        border-color: var(--red);
        color: var(--red-dark);
      }

      .btn-danger {
        background: rgba(133, 52, 57, 0.13);
        color: var(--red-dark);
        border: 1px solid rgba(133, 52, 57, 0.35);
        border-radius: 8px;
        padding: 10px 20px;
        font-family: "Poppins", sans-serif;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.15s;
      }

      .btn-danger:hover {
        background: rgba(133, 52, 57, 0.3);
      }

      .btn-gold {
        background: var(--gold);
        color: #1a1009;
        border: none;
        border-radius: 8px;
        padding: 10px 20px;
        font-family: "Poppins", sans-serif;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: background 0.15s;
      }

      .btn-gold:hover {
        background: var(--gold-light);
      }

      /* ── ALERT ── */
      .alert-cf {
        background: rgba(133, 52, 57, 0.1);
        border: 1px solid rgba(133, 52, 57, 0.35);
        color: var(--red-dark);
        border-radius: 8px;
        padding: 12px 16px;
        display: none;
        align-items: center;
        gap: 10px;
        font-size: 13.5px;
        margin-bottom: 16px;
      }

      .alert-cf.show {
        display: flex;
      }

      .alert-err {
        background: rgba(133, 52, 57, 0.12);
        border: 1px solid rgba(133, 52, 57, 0.35);
        color: var(--red-dark);
        border-radius: 8px;
        padding: 12px 16px;
        display: none;
        align-items: center;
        gap: 10px;
        font-size: 13.5px;
        margin-bottom: 16px;
      }

      .alert-err.show {
        display: flex;
      }

      /* ── TABLE ── */
      .table-wrap {
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
      }

      .table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 20px;
        border-bottom: 1px solid var(--border);
        gap: 12px;
        flex-wrap: wrap;
      }

      .table-info {
        font-size: 13px;
        color: var(--muted);
      }

      .table-info strong {
        color: var(--text);
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }

      thead tr {
        background: var(--bg3);
      }

      th {
        padding: 12px 16px;
        text-align: left;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        border-bottom: 1px solid var(--border);
      }

      tbody tr {
        border-bottom: 1px solid var(--border);
        transition: background 0.12s;
      }

      tbody tr:last-child {
        border-bottom: none;
      }
      tbody tr:hover {
        background: var(--bg3);
      }
      tbody tr.row-selected {
        background: rgba(133, 52, 57, 0.08);
      }

      td {
        padding: 13px 16px;
        font-size: 13.5px;
        color: var(--text);
        vertical-align: middle;
      }

      input[type="checkbox"] {
        width: 16px;
        height: 16px;
        accent-color: var(--red);
        cursor: pointer;
      }

      /* ── BADGES ── */
      .badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 500;
        letter-spacing: 0.04em;
      }

      .badge-cat {
        background: rgba(194, 168, 140, 0.3);
        color: var(--gold);
        border: 1px solid var(--border);
      }

      .badge-ativo {
        background: rgba(133, 52, 57, 0.1);
        color: var(--red-dark);
        border: 1px solid rgba(133, 52, 57, 0.3);
      }

      .badge-destaque {
        background: rgba(194, 168, 140, 0.35);
        color: var(--gold);
        border: 1px solid var(--border);
      }

      .badge-inativo {
        background: rgba(106, 90, 80, 0.12);
        color: var(--muted);
        border: 1px solid var(--border);
      }

      /* ── ACTION ICONS ── */
      .action-btn {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--muted);
        font-size: 14px;
        padding: 4px 6px;
        border-radius: 5px;
        transition:
          color 0.15s,
          background 0.15s;
      }

      .action-btn:hover {
        color: var(--text);
        background: var(--surface);
      }
      .action-btn.del:hover {
        color: var(--red-dark);
        background: rgba(133, 52, 57, 0.1);
      }

      /* ── UPLOAD AREA ── */
      .upload-area {
        border: 2px dashed var(--border);
        border-radius: 10px;
        padding: 28px;
        text-align: center;
        cursor: pointer;
        transition:
          border-color 0.2s,
          background 0.2s;
        color: var(--muted);
      }

      .upload-area:hover {
        border-color: var(--red);
        background: rgba(133, 52, 57, 0.05);
        color: var(--text);
      }
      .upload-area i {
        font-size: 28px;
        display: block;
        margin-bottom: 8px;
      }
      .upload-area input {
        display: none;
      }

      #imgPreviewEl {
        display: none;
        max-width: 160px;
        max-height: 160px;
        border-radius: 8px;
        border: 2px solid var(--border);
        margin-top: 10px;
      }

      /* ── DASHBOARD QUICK ACCESS ── */
      .quick-btn {
        width: 100%;
        text-align: left;
        margin-bottom: 8px;
        background: var(--bg3);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 12px 16px;
        font-family: "Poppins", sans-serif;
        font-size: 14px;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        transition:
          border-color 0.15s,
          background 0.15s;
      }

      .quick-btn i {
        color: var(--red);
      }
      .quick-btn:hover {
        border-color: var(--red);
        background: rgba(133, 52, 57, 0.06);
      }

      /* ── HORARIO ── */
      .horario-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid var(--border);
        font-size: 13.5px;
      }

      .horario-item:last-child {
        border-bottom: none;
      }
      .horario-item span:first-child {
        color: var(--muted);
      }
      .horario-item strong {
        color: var(--gold);
      }

      /* ── DIVIDER ── */
      .divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 24px 0;
      }

      /* ── EMPTY STATE ── */
      .empty-state {
        text-align: center;
        padding: 40px;
        color: var(--muted);
      }

      .empty-state i {
        font-size: 36px;
        margin-bottom: 12px;
        display: block;
        opacity: 0.4;
      }
      .empty-state p {
        font-size: 14px;
      }

      /* ── SELECTION BAR ── */
      .selection-bar {
        background: rgba(133, 52, 57, 0.12);
        border: 1px solid rgba(133, 52, 57, 0.3);
        border-radius: 8px;
        padding: 10px 16px;
        display: none;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
        font-size: 13px;
        color: var(--red-dark);
        gap: 12px;
        flex-wrap: wrap;
      }

      .selection-bar.show {
        display: flex;
      }

      /* ── REPORTS ── */
      .report-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 16px;
      }

      .report-card {
        background: var(--bg2);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
        transition:
          border-color 0.2s,
          transform 0.2s;
        cursor: pointer;
      }

      .report-card:hover {
        border-color: var(--red);
        transform: translateY(-2px);
      }

      .report-img {
        background: var(--bg3);
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 8px;
        color: var(--muted);
        font-size: 13px;
      }

      .report-img i {
        font-size: 32px;
        color: var(--red);
        opacity: 0.7;
      }

      .report-body {
        padding: 14px 16px;
      }
      .report-body h6 {
        font-size: 13.5px;
        font-weight: 500;
        color: var(--text);
        margin-bottom: 4px;
      }
      .report-body p {
        font-size: 12px;
        color: var(--muted);
      }

      /* ── PRICE DISPLAY ── */
      .price-text {
        color: var(--gold);
        font-weight: 500;
      }

      /* ── SCROLLBAR ── */
      ::-webkit-scrollbar {
        width: 6px;
        height: 6px;
      }
      ::-webkit-scrollbar-track {
        background: var(--bg);
      }
      ::-webkit-scrollbar-thumb {
        background: var(--surface);
        border-radius: 3px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--border);
      }

      /* ── MOBILE ── */
      @media (max-width: 768px) {
        #sidebar {
          transform: translateX(calc(-1 * var(--sidebar-w)));
        }
        #sidebar.open {
          transform: translateX(0);
        }
        #main {
          margin-left: 0 !important;
        }
        .page-content {
          padding: 16px;
        }
      }
    </style>
  </head>
  <body>
    <!-- ═══════ SIDEBAR ═══════ -->
    <aside id="sidebar">
      <div class="sidebar-brand">
        <div class="brand-logo">
          <div class="brand-icon">CF</div>
          <div class="brand-name">Corte Fino</div>
        </div>
        <div class="brand-sub">Painel Administrador</div>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-label">Geral</div>
        <a class="nav-link-cf active" data-section="dashboard">
          <i class="fa-solid fa-gauge-high"></i> Painel
        </a>

        <div class="nav-label">Gestão</div>
        <a class="nav-link-cf" data-section="produtos">
          <i class="fa-solid fa-box-open"></i> Produtos
        </a>
        <a class="nav-link-cf" data-section="cadastros">
          <i class="fa-solid fa-tags"></i> Categorias e Marcas
        </a>
        <a class="nav-link-cf" data-section="relatorios">
          <i class="fa-solid fa-chart-pie"></i> Relatorios
        </a>
      </nav>

      <div class="sidebar-footer">
        <a href="/">
          <i class="fa-solid fa-arrow-left"></i> Voltar ao Site
        </a>
      </div>
    </aside>

    <!-- ═══════ MAIN ═══════ -->
    <div id="main">
      <!-- TOPBAR -->
      <div class="topbar">
        <div style="display: flex; align-items: center; gap: 12px">
          <button class="btn-toggle" id="toggleSidebar">
            <i class="fa-solid fa-bars"></i>
          </button>
          <span class="topbar-title" id="topbarTitle">Painel</span>
        </div>
        <div class="topbar-right">
          <span class="topbar-badge"
            ><i
              class="fa-solid fa-circle"
              style="color: #853439; font-size: 8px; margin-right: 6px"
            ></i
            >Online</span
          >
          <div class="avatar">CF</div>
        </div>
      </div>

      <!-- ═══════ DASHBOARD ═══════ -->
      <div class="page-content active" id="section-dashboard">
        <div class="stat-row">
          <div class="stat-card">
            <div class="stat-icon"><i class="fa-solid fa-box-open"></i></div>
            <div>
              <div class="stat-value"><%= produtos.length %></div>
              <div class="stat-label">Produtos cadastrados</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><i class="fa-solid fa-star"></i></div>
            <div>
              <div class="stat-value"><%= categorias.length %></div>
              <div class="stat-label">Categorias cadastradas</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><i class="fa-solid fa-tag"></i></div>
            <div>
              <div class="stat-value"><%= marcas.length %></div>
              <div class="stat-label">Marcas cadastradas</div>
            </div>
          </div>
          <div class="stat-card">
            <div class="stat-icon"><i class="fa-solid fa-chart-line"></i></div>
            <div>
              <div class="stat-value">4</div>
              <div class="stat-label">Relatórios</div>
            </div>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px">
          <div class="form-card">
            <div class="section-title" style="margin-bottom: 16px">
              <i class="fa-solid fa-bolt"></i> Acesso Rápido
            </div>
            <button class="quick-btn" onclick="navigateTo('produtos')">
              <i class="fa-solid fa-plus"></i> Adicionar novo produto
            </button>
            <button class="quick-btn" onclick="navigateTo('relatorios')">
              <i class="fa-solid fa-upload"></i> Enviar relatório
            </button>
            <button class="quick-btn" onclick="navigateTo('produtos')">
              <i class="fa-solid fa-trash-can"></i> Gerenciar / excluir produtos
            </button>
          </div>
          <div class="form-card">
            <div class="section-title" style="margin-bottom: 16px">
              <i class="fa-solid fa-clock"></i> Funcionamento
            </div>
            <div class="horario-item">
              <span>Segunda a Sexta</span>
              <strong>7h – 19h</strong>
            </div>
            <div class="horario-item">
              <span>Sábado</span>
              <strong>7h – 18h</strong>
            </div>
            <div class="horario-item">
              <span>Domingo</span>
              <strong>7h – 13h</strong>
            </div>
            <div class="horario-item">
              <span>Feriados</span>
              <strong>8h – 12h</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- ═══════ PRODUTOS ═══════ -->
      <div class="page-content" id="section-produtos">
        <!-- FORMULARIO DE PRODUTO -->
        <div class="section-header">
          <div class="section-title">
            <i class="fa-solid fa-plus-circle"></i>
            <span id="tituloForm">Cadastrar Produto</span>
          </div>
        </div>

        <div class="form-card">
          <!-- guarda o id quando estamos editando um produto -->
          <input type="hidden" id="idProduto" value="" />

          <div class="form-row cols-2">
            <div>
              <label class="form-label">Nome do Produto *</label>
              <input
                type="text"
                id="nomeProduto"
                placeholder="Ex: Picanha Premium"
              />
            </div>
            <div>
              <label class="form-label">Categoria *</label>
              <select id="categoriaProduto">
                <option value="">Selecione...</option>
                <% for (let i = 0; i < categorias.length; i++) { %>
                <option value="<%= categorias[i].id %>">
                  <%= categorias[i].nomeCategoria %>
                </option>
                <% } %>
              </select>
            </div>
          </div>

          <div class="form-row cols-3">
            <div>
              <label class="form-label">Marca *</label>
              <select id="marcaProduto">
                <option value="">Selecione...</option>
                <% for (let i = 0; i < marcas.length; i++) { %>
                <option value="<%= marcas[i].id %>">
                  <%= marcas[i].nomeMarca %>
                </option>
                <% } %>
              </select>
            </div>
            <div>
              <label class="form-label">Preco (R$/kg) *</label>
              <input type="number" step="0.01" id="precoProduto" placeholder="0.00" />
            </div>
            <div>
              <label class="form-label">Quantidade em estoque *</label>
              <input type="number" id="estoqueProduto" placeholder="0" />
            </div>
          </div>

          <div class="form-row" style="margin-bottom: 16px">
            <div>
              <label class="form-label">Descricao</label>
              <textarea
                id="descProduto"
                rows="2"
                placeholder="Descricao breve..."
              ></textarea>
            </div>
          </div>

          <div style="display: flex; gap: 10px; margin-top: 8px">
            <button class="btn-red" id="btnGravar">
              <i class="fa-solid fa-floppy-disk"></i> Salvar Produto
            </button>
            <button class="btn-outline" id="btnLimpar">Limpar</button>
          </div>
        </div>

        <!-- TABELA DE PRODUTOS -->
        <div class="section-header">
          <div class="section-title">
            <i class="fa-solid fa-list-ul"></i> Produtos Cadastrados
          </div>
        </div>

        <div class="table-wrap">
          <div class="table-toolbar">
            <div class="table-info">
              Total: <strong><%= produtos.length %></strong> produto(s)
            </div>
          </div>
          <table>
            <thead>
              <tr>
                <th>Produto</th>
                <th>Categoria</th>
                <th>Marca</th>
                <th>Preco</th>
                <th>Estoque</th>
                <th style="width: 110px">Acoes</th>
              </tr>
            </thead>
            <tbody>
              <% if (produtos.length == 0) { %>
              <tr>
                <td colspan="6">
                  <div class="empty-state">
                    <i class="fa-solid fa-box-open"></i>
                    <p>Nenhum produto cadastrado ainda.</p>
                  </div>
                </td>
              </tr>
              <% } %>

              <% for (let i = 0; i < produtos.length; i++) { %>
              <tr>
                <td><%= produtos[i].NOME_PRODUTO %></td>
                <td><%= produtos[i].NOME_CATEGORIA %></td>
                <td><%= produtos[i].NOME_MARCA %></td>
                <td>R$ <%= produtos[i].PRECO_VENDA %></td>
                <td><%= produtos[i].QNT_ESTOQUE %></td>
                <td>
                  <button
                    class="btn-outline btnEditar"
                    data-id="<%= produtos[i].ID_PRODUTO %>"
                    data-nome="<%= produtos[i].NOME_PRODUTO %>"
                    data-categoria="<%= produtos[i].ID_CATEGORIA %>"
                    data-marca="<%= produtos[i].ID_MARCA %>"
                    data-preco="<%= produtos[i].PRECO_VENDA %>"
                    data-estoque="<%= produtos[i].QNT_ESTOQUE %>"
                    data-descricao="<%= produtos[i].DESCRICAO %>"
                  >
                    <i class="fa-solid fa-pen"></i>
                  </button>
                  <button
                    class="btn-danger btnExcluir"
                    data-id="<%= produtos[i].ID_PRODUTO %>"
                  >
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ======= CADASTROS (CATEGORIAS E MARCAS) ======= -->
      <div class="page-content" id="section-cadastros">
        <div class="section-header">
          <div class="section-title">
            <i class="fa-solid fa-tags"></i> Categorias
          </div>
        </div>

        <div class="form-card">
          <div class="form-row cols-2">
            <div>
              <label class="form-label">Nome da Categoria *</label>
              <input type="text" id="nomeCategoria" placeholder="Ex: Bovino" />
            </div>
            <div>
              <label class="form-label">Descricao</label>
              <input
                type="text"
                id="descCategoria"
                placeholder="Descricao breve..."
              />
            </div>
          </div>
          <div style="margin-top: 8px">
            <button class="btn-red" id="btnGravarCategoria">
              <i class="fa-solid fa-floppy-disk"></i> Salvar Categoria
            </button>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Categoria</th>
                <th>Descricao</th>
                <th style="width: 80px">Acoes</th>
              </tr>
            </thead>
            <tbody>
              <% if (categorias.length == 0) { %>
              <tr>
                <td colspan="3">
                  <div class="empty-state">
                    <p>Nenhuma categoria cadastrada ainda.</p>
                  </div>
                </td>
              </tr>
              <% } %>

              <% for (let i = 0; i < categorias.length; i++) { %>
              <tr>
                <td><%= categorias[i].nomeCategoria %></td>
                <td><%= categorias[i].descricao %></td>
                <td>
                  <button
                    class="btn-danger btnExcluirCategoria"
                    data-id="<%= categorias[i].id %>"
                  >
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <div class="section-header" style="margin-top: 28px">
          <div class="section-title">
            <i class="fa-solid fa-copyright"></i> Marcas
          </div>
        </div>

        <div class="form-card">
          <div class="form-row">
            <div>
              <label class="form-label">Nome da Marca *</label>
              <input type="text" id="nomeMarca" placeholder="Ex: Friboi" />
            </div>
          </div>
          <div style="margin-top: 8px">
            <button class="btn-red" id="btnGravarMarca">
              <i class="fa-solid fa-floppy-disk"></i> Salvar Marca
            </button>
          </div>
        </div>

        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Marca</th>
                <th style="width: 80px">Acoes</th>
              </tr>
            </thead>
            <tbody>
              <% if (marcas.length == 0) { %>
              <tr>
                <td colspan="2">
                  <div class="empty-state">
                    <p>Nenhuma marca cadastrada ainda.</p>
                  </div>
                </td>
              </tr>
              <% } %>

              <% for (let i = 0; i < marcas.length; i++) { %>
              <tr>
                <td><%= marcas[i].nomeMarca %></td>
                <td>
                  <button
                    class="btn-danger btnExcluirMarca"
                    data-id="<%= marcas[i].id %>"
                  >
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ═══════ RELATÓRIOS ═══════ -->
      <div class="page-content" id="section-relatorios">
        <div class="section-header">
          <div class="section-title">
            <i class="fa-solid fa-chart-pie"></i> Relatórios
          </div>
          <label class="btn-red" for="uploadRelatorio" style="cursor: pointer">
            <i class="fa-solid fa-upload"></i> Enviar Relatório
            <input
              type="file"
              id="uploadRelatorio"
              accept="image/*"
              style="display: none"
              onchange="adicionarRelatorio(this)"
            />
          </label>
        </div>

        <div class="report-grid" id="reportGrid">
          <div class="report-card">
            <div class="report-img">
              <i class="fa-solid fa-chart-bar"></i><span>Jan 2025</span>
            </div>
            <div class="report-body">
              <h6>Vendas — Janeiro 2025</h6>
              <p>Relatório mensal por categoria</p>
            </div>
          </div>
          <div class="report-card">
            <div class="report-img">
              <i class="fa-solid fa-chart-line"></i><span>Fev 2025</span>
            </div>
            <div class="report-body">
              <h6>Estoque — Fevereiro 2025</h6>
              <p>Controle e movimentação</p>
            </div>
          </div>
          <div class="report-card">
            <div class="report-img">
              <i class="fa-solid fa-chart-pie"></i><span>Q1 2025</span>
            </div>
            <div class="report-body">
              <h6>Desempenho — Q1 2025</h6>
              <p>Análise trimestral de resultados</p>
            </div>
          </div>
          <div class="report-card">
            <div class="report-img">
              <i class="fa-solid fa-users"></i><span>Mar 2025</span>
            </div>
            <div class="report-body">
              <h6>Clientes — Março 2025</h6>
              <p>Base de clientes e pedidos</p>
            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- /main -->

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        // ──────────────────────────────────────────────
        // SIDEBAR
        // ──────────────────────────────────────────────
        document
          .querySelector("#toggleSidebar")
          .addEventListener("click", function () {
            var sidebar = document.querySelector("#sidebar");
            var main = document.querySelector("#main");

            if (window.innerWidth <= 768) {
              sidebar.classList.toggle("open");
            } else {
              sidebar.classList.toggle("collapsed");
              main.classList.toggle("expanded");
            }
          });

        // ──────────────────────────────────────────────
        // NAVEGACAO ENTRE AS SECOES
        // ──────────────────────────────────────────────
        var titulos = {
          dashboard: "Painel",
          produtos: "Produtos",
          cadastros: "Categorias e Marcas",
          relatorios: "Relatorios",
        };

        function navigateTo(secao) {
          document.querySelectorAll(".page-content").forEach(function (el) {
            el.classList.remove("active");
          });
          document.querySelectorAll(".nav-link-cf").forEach(function (el) {
            el.classList.remove("active");
          });
          document.querySelector("#section-" + secao).classList.add("active");
          document
            .querySelector('[data-section="' + secao + '"]')
            .classList.add("active");
          document.querySelector("#topbarTitle").textContent = titulos[secao];
        }

        // deixa a funcao disponivel para os botoes de acesso rapido
        window.navigateTo = navigateTo;

        document.querySelectorAll(".nav-link-cf").forEach(function (link) {
          link.addEventListener("click", function (e) {
            e.preventDefault();
            navigateTo(this.getAttribute("data-section"));
          });
        });

        // ──────────────────────────────────────────────
        // PRODUTOS - GRAVAR (cadastrar ou alterar)
        // ──────────────────────────────────────────────
        var btnGravar = document.querySelector("#btnGravar");
        btnGravar.addEventListener("click", gravarProduto);

        function gravarProduto() {
          var id = document.querySelector("#idProduto");
          var nome = document.querySelector("#nomeProduto");
          var categoria = document.querySelector("#categoriaProduto");
          var marca = document.querySelector("#marcaProduto");
          var preco = document.querySelector("#precoProduto");
          var estoque = document.querySelector("#estoqueProduto");
          var descricao = document.querySelector("#descProduto");

          if (
            nome.value != "" &&
            categoria.value != "" &&
            marca.value != "" &&
            preco.value != "" &&
            estoque.value != ""
          ) {
            // monta o objeto que sera enviado ao backend
            var obj = {
              id: id.value,
              nome: nome.value,
              categoria: categoria.value,
              marca: marca.value,
              preco: preco.value,
              estoque: estoque.value,
              descricao: descricao.value,
            };

            // se tem id preenchido estamos alterando, senao cadastrando
            var url =
              id.value == "" ? "/produto/cadastrar" : "/produto/alterar";

            fetch(url, {
              method: "POST",
              body: JSON.stringify(obj),
              headers: { "Content-Type": "application/json" },
            })
              .then(function (resposta) {
                return resposta.json();
              })
              .then(function (corpoResposta) {
                if (corpoResposta.ok) {
                  alert("Produto gravado com sucesso!");
                  window.location.reload();
                } else {
                  alert("Erro ao gravar o produto!");
                }
              });
          } else {
            alert("Preencha corretamente todos os campos obrigatorios!");
          }
        }

        // ──────────────────────────────────────────────
        // PRODUTOS - LIMPAR O FORMULARIO
        // ──────────────────────────────────────────────
        document
          .querySelector("#btnLimpar")
          .addEventListener("click", limparFormulario);

        function limparFormulario() {
          document.querySelector("#idProduto").value = "";
          document.querySelector("#nomeProduto").value = "";
          document.querySelector("#categoriaProduto").value = "";
          document.querySelector("#marcaProduto").value = "";
          document.querySelector("#precoProduto").value = "";
          document.querySelector("#estoqueProduto").value = "";
          document.querySelector("#descProduto").value = "";
          document.querySelector("#tituloForm").textContent =
            "Cadastrar Produto";
        }

        // ──────────────────────────────────────────────
        // PRODUTOS - EDITAR (preenche o formulario)
        // ──────────────────────────────────────────────
        var botoesEditar = document.querySelectorAll(".btnEditar");

        for (var i = 0; i < botoesEditar.length; i++) {
          botoesEditar[i].addEventListener("click", editarProduto);
        }

        function editarProduto() {
          document.querySelector("#idProduto").value = this.dataset.id;
          document.querySelector("#nomeProduto").value = this.dataset.nome;
          document.querySelector("#categoriaProduto").value =
            this.dataset.categoria;
          document.querySelector("#marcaProduto").value = this.dataset.marca;
          document.querySelector("#precoProduto").value = this.dataset.preco;
          document.querySelector("#estoqueProduto").value =
            this.dataset.estoque;
          document.querySelector("#descProduto").value = this.dataset.descricao;
          document.querySelector("#tituloForm").textContent = "Alterar Produto";

          document
            .querySelector("#nomeProduto")
            .scrollIntoView({ behavior: "smooth" });
        }

        // ──────────────────────────────────────────────
        // PRODUTOS - EXCLUIR
        // ──────────────────────────────────────────────
        var botoesExcluir = document.querySelectorAll(".btnExcluir");

        for (var j = 0; j < botoesExcluir.length; j++) {
          botoesExcluir[j].addEventListener("click", excluirProduto);
        }

        function excluirProduto() {
          var id = this.dataset.id;

          if (confirm("Deseja realmente excluir este produto?")) {
            fetch("/produto/excluir/" + id, { method: "DELETE" })
              .then(function (resposta) {
                return resposta.json();
              })
              .then(function (corpoResposta) {
                if (corpoResposta.ok) {
                  window.location.reload();
                } else {
                  alert("Erro ao excluir o produto!");
                }
              });
          }
        }

        // ──────────────────────────────────────────────
        // CATEGORIAS - GRAVAR
        // ──────────────────────────────────────────────
        document
          .querySelector("#btnGravarCategoria")
          .addEventListener("click", gravarCategoria);

        function gravarCategoria() {
          var nome = document.querySelector("#nomeCategoria");
          var descricao = document.querySelector("#descCategoria");

          if (nome.value != "") {
            var obj = { nome: nome.value, descricao: descricao.value };

            fetch("/categoria/cadastrar", {
              method: "POST",
              body: JSON.stringify(obj),
              headers: { "Content-Type": "application/json" },
            })
              .then(function (resposta) {
                return resposta.json();
              })
              .then(function (corpoResposta) {
                if (corpoResposta.ok) {
                  alert("Categoria cadastrada com sucesso!");
                  window.location.reload();
                } else {
                  alert("Erro ao cadastrar a categoria!");
                }
              });
          } else {
            alert("Informe o nome da categoria!");
          }
        }

        // ──────────────────────────────────────────────
        // CATEGORIAS - EXCLUIR
        // ──────────────────────────────────────────────
        var botoesExcluirCategoria = document.querySelectorAll(
          ".btnExcluirCategoria",
        );

        for (var k = 0; k < botoesExcluirCategoria.length; k++) {
          botoesExcluirCategoria[k].addEventListener("click", excluirCategoria);
        }

        function excluirCategoria() {
          var id = this.dataset.id;

          if (confirm("Deseja realmente excluir esta categoria?")) {
            fetch("/categoria/excluir/" + id, { method: "DELETE" })
              .then(function (resposta) {
                return resposta.json();
              })
              .then(function (corpoResposta) {
                if (corpoResposta.ok) {
                  window.location.reload();
                } else {
                  alert(
                    "Erro ao excluir! Verifique se existe produto usando esta categoria.",
                  );
                }
              });
          }
        }

        // ──────────────────────────────────────────────
        // MARCAS - GRAVAR
        // ──────────────────────────────────────────────
        document
          .querySelector("#btnGravarMarca")
          .addEventListener("click", gravarMarca);

        function gravarMarca() {
          var nome = document.querySelector("#nomeMarca");

          if (nome.value != "") {
            var obj = { nome: nome.value };

            fetch("/marca/cadastrar", {
              method: "POST",
              body: JSON.stringify(obj),
              headers: { "Content-Type": "application/json" },
            })
              .then(function (resposta) {
                return resposta.json();
              })
              .then(function (corpoResposta) {
                if (corpoResposta.ok) {
                  alert("Marca cadastrada com sucesso!");
                  window.location.reload();
                } else {
                  alert("Erro ao cadastrar a marca!");
                }
              });
          } else {
            alert("Informe o nome da marca!");
          }
        }

        // ──────────────────────────────────────────────
        // MARCAS - EXCLUIR
        // ──────────────────────────────────────────────
        var botoesExcluirMarca = document.querySelectorAll(".btnExcluirMarca");

        for (var m = 0; m < botoesExcluirMarca.length; m++) {
          botoesExcluirMarca[m].addEventListener("click", excluirMarca);
        }

        function excluirMarca() {
          var id = this.dataset.id;

          if (confirm("Deseja realmente excluir esta marca?")) {
            fetch("/marca/excluir/" + id, { method: "DELETE" })
              .then(function (resposta) {
                return resposta.json();
              })
              .then(function (corpoResposta) {
                if (corpoResposta.ok) {
                  window.location.reload();
                } else {
                  alert(
                    "Erro ao excluir! Verifique se existe produto usando esta marca.",
                  );
                }
              });
          }
        }
      });
    </script>
  </body>
</html>
