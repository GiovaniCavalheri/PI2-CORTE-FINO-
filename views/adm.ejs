<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte Fino - Açougue Gourmet</title>
    <link
      rel="shortcut icon"
      href="/images/icon-Corte-Fino.ico"
      type="image/x-icon"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="/CSS/style.css" />
  </head>



  <body>
    <%- include("partials/header", { currentPage: "adm" }) %>
    <section
      class="secao-login d-flex justify-content-center align-items-center min-vh-100 py-5"
    >
      <div class="container-login text-center">
        <!-- LOGO -->
        <img
          src="/images/logo-c-f.png"
          alt="Logo Corte Fino"
          class="login-logo w-75 mb-3"
        />

        <!-- CARD -->
        <div
          class="card-login shadow p-4 rounded mx-auto"
          style="max-width: 380px"
        >
          <h2 class="titulo-login fw-bold fs-4">Área do ADM</h2>

          <p class="descricao-login mb-4">
            Entre com suas credenciais para acessar sua conta ADM
          </p>

          <!-- FORM -->
          <form class="form-login text-start">
            <label for="email" class="form-label">E-mail</label>

            <input
              type="email"
              id="email"
              placeholder="seu@email.com"
              class="form-control mb-3"
              required
            />

            <div
              class="linha-input d-flex justify-content-between align-items-center"
            >
              <label for="senha" class="form-label mb-0">Senha</label>


            </div>

            <input
              type="password"
              id="senha"
              placeholder="********"
              class="form-control mb-3"
              required
            />

            <button type="submit" class="btn-login btn w-100 mt-2">
              Entrar
            </button>
          </form>

        </div>

        <p class="texto-termos mt-3 small">
          Ao fazer login, você concorda com nossos
          <a href="#" class="text-decoration-none">Termos de Uso</a>
          e
          <a href="#" class="text-decoration-none">Política de Privacidade</a>
        </p>
      </div>
    </section>
    <!-- RODAPÉ -->
    <%- include("partials/footer", { footerType: "compact" }) %>


  </body>

  <script src="/JS/scripts/adm.js"></script>
</html>
