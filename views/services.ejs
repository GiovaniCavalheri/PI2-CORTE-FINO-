<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte Fino - Açougue Gourmet</title>

    <!-- BOOTSTRAP CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- FAVICON -->
    <link rel="shortcut icon" href="/images/icon-Corte-Fino.ico" />

    <!-- ICONES -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
      rel="stylesheet"
    />

    <!-- FONTE -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- CSS (PADRÃO DO INDEX) -->
    <link rel="stylesheet" href="/CSS/style.css" />
  </head>



  <body>
    <%- include("partials/header", { currentPage: "services" }) %>
    <!-- HERO -->
    <section class="hero-section3 d-flex align-items-center">
      <div class="container">
        <span class="border-premium">Serviços</span>

        <h1 class="hero-title">
          Soluções completas com qualidade e precisão em cada detalhe
        </h1>

        <p class="hero-subtitle1">
          Do corte à entrega, oferecemos serviços pensados para garantir
          praticidade, excelência e a melhor experiência para você.
        </p>
      </div>
    </section>
    <!-- CARDS -->
    <section class="services-section py-5">
      <div class="container">
        <section class="services-section">
          <div class="services-header">
            <span class="subtitle-premium">O Padrão Corte Fino</span>
            <h2>A Experiência Completa Onde Você Estiver</h2>
            <p>Do corte perfeito à praticidade no seu dia a dia ou evento.</p>
          </div>
        </section>
        <div class="row g-4">
          <div class="col-md-3">
            <div class="service-card">
              <div class="icon"><i class="fa-solid fa-truck"></i></div>
              <h3>Entrega em Domicílio</h3>
              <p>
                Levamos até você carnes com frescor, segurança e praticidade.
              </p>
            </div>
          </div>

          <div class="col-md-3">
            <div class="service-card">
              <div class="icon">
                <i class="fa-solid fa-champagne-glasses"></i>
              </div>
              <h3>Eventos</h3>
              <p>Suporte completo para churrascos e eventos especiais.</p>
            </div>
          </div>

          <div class="col-md-3">
            <div class="service-card">
              <div class="icon"><i class="fa-solid fa-scissors"></i></div>
              <h3>Cortes Especiais</h3>
              <p>Cortes personalizados para cada tipo de preparo.</p>
            </div>
          </div>

          <div class="col-md-3">
            <div class="service-card">
              <div class="icon"><i class="fa-solid fa-gift"></i></div>
              <h3>Kits e Combos</h3>
              <p>Combinações ideais para facilitar sua rotina.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section text-center py-5">
      <h2>Precisa de um serviço personalizado?</h2>
      <p>Nossa equipe está pronta para te atender.</p>
      <a
        href="https://wa.me/5518997732006?text=Olá%20Corte%20Fino,%20gostaria%20de%20solicitar%20atendimento%20para%20um%20serviço%20personalizado."
      >
        <button class="btn-events mt-3 py-2" type="submit">
          Falar com Especialista
        </button>
      </a>
    </section>

    <!-- RODAPÉ -->
    <%- include("partials/footer", { footerType: "default" }) %>


  </body>
</html>
