<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte Fino - Açougue Gourmet</title>

    <!-- BOOTSTRAP CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- FAVICON -->
    <link rel="shortcut icon" href="/images/icon-Corte-Fino.ico" />

    <!-- ICONES -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
      rel="stylesheet"
    />

    <!-- FONTE -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- CSS (PADRÃO DO INDEX) -->

    <link rel="stylesheet" href="/CSS/style.css" />
  </head>

  <body>
    <%- include("partials/header", { currentPage: "offers" }) %>
    <!-- HEADER TOP - Informações de contato -->
    <section>


    <!-- OFERTAS -->
    <section class="highlights-of-the-week1 py-5">
      <div class="container">
        <h2 class="text-center fw-bold mb-2" style="color: #2e1a16">
          Destaques da Semana
        </h2>

        <p class="sub-high text-center mb-5">
          Cortes selecionados para uma experiência premium
        </p>
        <div class="row g-4 justify-space-evenly">
          <!-- CARD 1 -->
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card-produto h-100">
              <div class="badge-card">Mais Vendido</div>

              <img
                src="/images/Cards-Produtos/file-mignon-card.png"
                alt="Filé Mignon"
              />
              <h3>Filé Mignon</h3>
              <p>
                Corte nobre extremamente macio, ideal para grelhar ou assar.
              </p>

              <div class="info-carne">
                <span>Angus Certificado</span>
                <span>Ideal para churrasco</span>
                <span>Oferta válida até sábado</span>
              </div>

              <div class="preco-card">
                <span class="preco-antigo"> R$ 119,90/kg </span>

                <span class="preco-novo"> R$ 89,90 </span>
              </div>

              <a
                href="https://wa.me/5518997732006?text=Olá%20Corte%20Fino,%20tenho%20interesse%20no%Filé%Mignon."
                target="_blank"
              >
                <button class="button-orçamento w-100">
                  Pedir no WhatsApp
                </button>
              </a>
            </div>
          </div>

          <!-- CARD 2 -->
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card-produto h-100">
              <div class="badge-card">Escolha Recomendada</div>

              <img
                src="/images/Cards-Produtos/panceta-products.png"
                alt="Panceta Bovina"
              />
              <h3>Panceta Bovina</h3>
              <p>
                Versátil e saborosa, perfeita para churrasco ou receitas do dia
                a dia.
              </p>

              <div class="info-carne">
                <span>Corte Premium Selecionado</span>
                <span>Ideal para harmonização</span>
                <span>Maciez excepcional</span>
              </div>

              <div class="preco-card">
                <span class="preco-antigo"> R$ 54,90/kg </span>

                <span class="preco-novo"> R$ 34,90 </span>
              </div>

              <a
                href="https://wa.me/5518997732006?text=Olá%20Corte%20Fino,%20tenho%20interesse%20na%Peça de %Alcatra %20Prime."
                target="_blank"
              >
                <button class="button-orçamento w-100">
                  Pedir no WhatsApp
                </button>
              </a>
            </div>
          </div>
          <div class="col-12 col-md-6 col-lg-4">
            <div class="card-produto h-100">
              <div class="badge-card">Escolha Recomendada</div>

              <img
                src="/images/Cards-Produtos/picanha-products.png"
                alt="Filé Mignon"
              />
              <h3>Picanha Premium</h3>
              <p>
                Corte especial com marmoreio perfeito para um churrasco
                suculento.
              </p>

              <div class="info-carne">
                <span>Corte Premium Selecionado</span>
                <span>Ideal para dividir com a família</span>
                <span>Maciez surpreendente</span>
              </div>

              <div class="preco-card">
                <span class="preco-antigo"> R$ 109,90/kg </span>

                <span class="preco-novo"> R$ 89,90 </span>
              </div>

              <a
                href="https://wa.me/5518997732006?text=Olá%20Corte%20Fino,%20tenho%20interesse%20no%20Picanha%20Prime."
                target="_blank"
              >
                <button class="button-orçamento w-100">
                  Pedir no WhatsApp
                </button>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- FOOTER -->
    <%- include("partials/footer", { footerType: "default" }) %>

    <script src="/JS/scripts/products.js" defer></script>
  </body>
</html>
