<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte Fino - Cadastro</title>

    <link
      rel="shortcut icon"
      href="/images/icon-Corte-Fino.ico"
      type="image/x-icon"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/CSS/style.css" />

    <style>
      .btn-tipo {
        padding: 8px 0;
        width: 8rem;
        border: 2px solid #8b0000;
        background: transparent;
        color: #8b0000;
        font-weight: 600;
        border-radius: 6px;
        cursor: pointer;
        font-family: "Poppins", sans-serif;
        transition: all 0.2s;
      }

      .btn-ativo {
        background: #8b0000;
        color: white;
      }

      .grupo-radio {
        margin-bottom: 12px;
      }
    </style>
  </head>

  <body>
    <%- include("partials/header", { currentPage: "cadastro" }) %>


    <!-- SEÇÃO DE CADASTRO -->
    <section
      class="secao-login d-flex justify-content-center align-items-center min-vh-100 py-5"
    >
      <div class="container-login text-center">
        <img
          src="/images/logo-c-f.png"
          alt="Logo Corte Fino"
          class="login-logo w-75 mb-3"
        />

        <div
          class="card-login shadow p-4 rounded mx-auto"
          style="max-width: 420px"
        >
          <h2 class="titulo-login fw-bold fs-4">Cadastre-se</h2>

          <p class="descricao-login mb-4">
            Crie sua conta para acessar a página.
          </p>

          <!-- BOTÕES DE ALTERNÂNCIA -->
          <div class="d-flex justify-content-center gap-2 mb-4">
            <button
              id="btnSocio"
              class="btn-tipo btn-ativo"
              onclick="mostrarForm('socio')"
            >
              Sócio
            </button>

            <button
              id="btnFornecedor"
              class="btn-tipo"
              onclick="mostrarForm('fornecedor')"
            >
              Fornecedor
            </button>
          </div>

          <!-- FORMULÁRIO SÓCIO -->
          <form
            id="formSocio"
            class="text-start"
            novalidate
            onsubmit="validarCadastro(event, 'socio')"
          >
            <div>
              <label for="nameSocio" class="form-label">Nome</label>
              <input
                type="text"
                id="nameSocio"
                name="nameSocio"
                placeholder="Seu Nome Completo"
                class="form-control mb-3"
                required
              />
            </div>

            <div>
              <label for="nascimento" class="form-label"
                >Data de Nascimento</label
              >
              <input
                type="date"
                id="nascimento"
                name="datetime"
                class="form-control mb-3"
                required
              />
            </div>

            <div>
              <label for="CPF" class="form-label">CPF</label>
              <input
                type="text"
                id="CPF"
                name="CPF"
                placeholder="000.000.000-00"
                class="form-control mb-3"
                onkeyup="mCpf(this)"
                maxlength="14"
                required
              />
            </div>

            <div>
              <label for="RG" class="form-label">RG</label>
              <input
                type="text"
                id="RG"
                name="RG"
                placeholder="00.000.000-0"
                class="form-control mb-3"
                onkeyup="mRG(this)"
                maxlength="12"
                required
              />
            </div>

            <div>
              <label for="emailSocio" class="form-label">E-mail</label>
              <input
                type="email"
                id="emailSocio"
                name="emailSocio"
                placeholder="seu@email.com"
                class="form-control mb-3"
                onblur="validarEmail(this)"
                required
              />
            </div>

            <div>
              <label for="CelularSocio" class="form-label">Celular</label>
              <input
                type="tel"
                id="CelularSocio"
                name="CelularSocio"
                placeholder="(00) 00000-0000"
                class="form-control mb-3"
                onkeyup="mTel(this)"
                maxlength="14"
                required
              />
            </div>

            <div>
              <label for="TelefoneSocio" class="form-label"
                >Telefone Comercial</label
              >
              <input
                type="tel"
                id="TelefoneSocio"
                name="TelefoneSocio"
                placeholder="(00) 00000-0000"
                class="form-control mb-3"
                onkeyup="mTel(this)"
                maxlength="14"
                required
              />
            </div>

            <div>
              <label for="CEPSocio">CEP</label>
              <input
                type="text"
                id="CEPSocio"
                class="form-control"
                oninput="
                  mCEP(this);
                  buscarCEP(
                    'CEPSocio',
                    'CidadeSocio',
                    'EstadoSocio',
                    'BairroSocio',
                  );
                "
              />
            </div>

            <div>
              <label for="CidadeSocio" class="form-label">Cidade</label>
              <input
                type="text"
                id="CidadeSocio"
                name="CidadeSocio"
                placeholder="Presidente Prudente"
                class="form-control mb-3"
                onkeyup="mTexto(this)"
                required
              />
            </div>

            <div>
              <label for="EstadoSocio" class="form-label">Estado</label>
              <input
                type="text"
                id="EstadoSocio"
                name="EstadoSocio"
                placeholder="São Paulo"
                class="form-control mb-3"
                required
              />
            </div>

            <div>
              <label for="BairroSocio" class="form-label">Bairro</label>
              <input
                type="text"
                id="BairroSocio"
                name="BairroSocio"
                placeholder="Vila Vera"
                class="form-control mb-3"
                required
              />
            </div>

            <div>
              <label for="numberRedSocio" class="form-label"
                >Número da residência</label
              >

              <div class="mb-3">
                <input
                  type="number"
                  id="numberRedSocio"
                  name="numberRedSocio"
                  class="form-control"
                  required
                />

                <div class="invalid-feedback"></div>
              </div>
            </div>

            <div>
              <label for="ComplementoSocio" class="form-label"
                >Complemento</label
              >
              <input
                type="text"
                id="ComplementoSocio"
                name="ComplementoSocio"
                placeholder="Bloco 3, Apartamento 10"
                class="form-control mb-3"
              />
            </div>

            <div>
              <label for="senhaSocio" class="form-label">Senha</label>

              <div class="mb-3">
                <input
                  type="password"
                  id="senhaSocio"
                  name="senhaSocio"
                  placeholder="********"
                  class="form-control"
                  required
                />

                <div class="invalid-feedback"></div>
              </div>
            </div>

            <div>
              <label for="senhaConfirmaSocio" class="form-label"
                >Confirmar Senha</label
              >

              <div class="mb-3">
                <input
                  type="password"
                  id="senhaConfirmaSocio"
                  name="senhaConfirmaSocio"
                  placeholder="********"
                  class="form-control"
                  required
                />

                <div class="invalid-feedback"></div>
              </div>
            </div>

            <button type="submit" class="btn-login btn w-100 mt-2">
              Cadastrar-se
            </button>
          </form>

          <!-- FORMULÁRIO FORNECEDOR -->
          <form
            id="formFornecedor"
            class="text-start"
            style="display: none"
            novalidate
            onsubmit="validarCadastro(event, 'fornecedor')"
          >
            <div>
              <label for="razaosocial" class="form-label">Razão Social</label>
              <input
                type="text"
                id="razaosocial"
                name="razaosocial"
                placeholder="Razão Social da Empresa"
                class="form-control mb-3"
                required
              />
            </div>

            <div>
              <label for="fantasyname" class="form-label">Nome Fantasia</label>
              <input
                type="text"
                id="fantasyname"
                name="fantasyname"
                placeholder="Ex: Corte Fino"
                class="form-control mb-3"
                required
              />
            </div>

            <div>
              <label for="CNPJ" class="form-label">CNPJ</label>
              <input
                type="text"
                id="CNPJ"
                name="CNPJ"
                placeholder="00.000.000/0000-00"
                class="form-control mb-3"
                onkeyup="mCNPJ(this)"
                maxlength="18"
                required
              />
            </div>

            <div>
              <label for="nameFornecedor" class="form-label"
                >Nome do Responsável</label
              >
              <input
                type="text"
                id="nameFornecedor"
                name="nameFornecedor"
                placeholder="Nome Completo"
                class="form-control mb-3"
                onkeyup="mTexto(this)"
                required
              />
            </div>

            <div>
              <label for="CPFFornecedor" class="form-label"
                >CPF do Responsável</label
              >
              <input
                type="text"
                id="CPFFornecedor"
                name="CPFFornecedor"
                placeholder="000.000.000-00"
                class="form-control mb-3"
                onkeyup="mCpf(this)"
                maxlength="14"
                required
              />
            </div>

            <div>
              <label for="emailFornecedor" class="form-label"
                >E-mail Corporativo</label
              >
              <input
                type="email"
                id="emailFornecedor"
                name="emailFornecedor"
                placeholder="contato@empresa.com"
                class="form-control mb-3"
                onblur="validarEmail(this)"
                required
              />
            </div>

            <div>
              <label for="TelefoneComercialFornecedor" class="form-label"
                >Telefone Comercial</label
              >
              <input
                type="tel"
                id="TelefoneComercialFornecedor"
                name="TelefoneComercialFornecedor"
                placeholder="(00) 0000-0000"
                class="form-control mb-3"
                onkeyup="mTel(this)"
                maxlength="14"
                required
              />
            </div>

            <div>
              <label for="CelularFornecedor" class="form-label"
                >Celular / WhatsApp</label
              >
              <input
                type="tel"
                id="CelularFornecedor"
                name="CelularFornecedor"
                placeholder="(00) 00000-0000"
                class="form-control mb-3"
                onkeyup="mTel(this)"
                maxlength="14"
                required
              />
            </div>

            <div>
              <label for="CEPFornecedor">CEP</label>
              <input
                type="text"
                id="CEPFornecedor"
                class="form-control"
                oninput="
                  mCEP(this);
                  buscarCEP(
                    'CEPFornecedor',
                    'CidadeFornecedor',
                    'EstadoFornecedor',
                    'BairroFornecedor',
                  );
                "
              />
            </div>

            <div>
              <label for="CidadeFornecedor" class="form-label">Cidade</label>
              <input
                type="text"
                id="CidadeFornecedor"
                name="CidadeFornecedor"
                placeholder="Presidente Prudente"
                class="form-control mb-3"
                onkeyup="mTexto(this)"
                required
              />
            </div>

            <div>
              <label for="EstadoFornecedor" class="form-label">Estado</label>
              <input
                type="text"
                id="EstadoFornecedor"
                name="EstadoFornecedor"
                placeholder="São Paulo"
                class="form-control mb-3"
                required
              />
            </div>

            <div>
              <label for="BairroFornecedor" class="form-label">Bairro</label>
              <input
                type="text"
                id="BairroFornecedor"
                name="BairroFornecedor"
                placeholder="Vila Vera"
                class="form-control mb-3"
                required
              />
            </div>

            <div>
              <label for="numberRedFornecedor" class="form-label"
                >Número do Endereço</label
              >

              <div class="mb-3">
                <input
                  type="number"
                  id="numberRedFornecedor"
                  name="numberRedFornecedor"
                  placeholder="000"
                  class="form-control"
                  required
                />

                <div class="invalid-feedback"></div>
              </div>
            </div>

            <div class="grupo-radio mb-3">
              <label class="form-label d-block"
                >Forma de Pagamento Aceita</label
              >

              <input
                class="form-check-input"
                type="radio"
                name="pagamento"
                id="debcred"
                value="debcred"
              />
              <label class="form-check-label" for="debcred">
                Cartão Débito/Crédito</label
              ><br />

              <input
                class="form-check-input"
                type="radio"
                name="pagamento"
                id="ted"
                value="ted"
              />
              <label class="form-check-label" for="ted">
                Transferência TED</label
              ><br />

              <input
                class="form-check-input"
                type="radio"
                name="pagamento"
                id="pix"
                value="pix"
              />
              <label class="form-check-label" for="pix"> PIX</label><br />

              <input
                class="form-check-input"
                type="radio"
                name="pagamento"
                id="cheque"
                value="cheque"
              />
              <label class="form-check-label" for="cheque"> Cheque</label>

              <div class="invalid-feedback d-block" id="erroPagamento"></div>
            </div>

            <div>
              <label for="senhaFornecedor" class="form-label">Senha</label>

              <div class="mb-3">
                <input
                  type="password"
                  id="senhaFornecedor"
                  name="senhaFornecedor"
                  placeholder="********"
                  class="form-control"
                  required
                />

                <div class="invalid-feedback"></div>
              </div>
            </div>

            <div>
              <label for="senhaConfirmaFornecedor" class="form-label"
                >Confirmar Senha</label
              >

              <div class="mb-3">
                <input
                  type="password"
                  id="senhaConfirmaFornecedor"
                  name="senhaConfirmaFornecedor"
                  placeholder="********"
                  class="form-control"
                  required
                />

                <div class="invalid-feedback"></div>
              </div>
            </div>

            <button type="submit" class="btn-login btn w-100 mt-2">
              Cadastrar-se
            </button>
          </form>
        </div>

        <p class="texto-termos mt-3 small">
          Ao fazer o cadastro, você concorda com nossos
          <a href="#" class="text-decoration-none">Termos de Uso</a> e
          <a href="#" class="text-decoration-none">Política de Privacidade</a>
        </p>
      </div>
    </section>

    <!-- RODAPÉ -->
    <%- include("partials/footer", { footerType: "default" }) %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/JS/scripts/cadastro.js"></script>
  </body>
</html>


