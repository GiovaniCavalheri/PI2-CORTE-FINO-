<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte Fino - Contato</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="shortcut icon" href="/images/icon-Corte-Fino.ico" />
    <link rel="stylesheet" href="/CSS/style.css" />
  </head>

  <body>
    <%- include("partials/header", { currentPage: "contact" }) %>


    <!-- SEÇÃO CONTATO -->
    <section class="cf-contato py-5">
      <div class="container">
        <div class="row g-4">
          <!-- FORMULÁRIO -->
          <div class="col-lg-7">
            <div class="cf-card p-4 cf-anim" data-delay="0">
              <h4 class="mb-2">Entre em Contato</h4>
              <p class="text-muted small">
                Preencha o formulário e nossa equipe retornará o mais rápido
                possível.
              </p>

              <form
                id="formContato"
                onsubmit="validarContato(event)"
                novalidate
              >
                <div class="row g-3">
                  <!-- Nome -->
                  <div class="col-md-6">
                    <label for="contatoNome" class="form-label">Nome *</label>
                    <input
                      type="text"
                      class="form-control"
                      id="contatoNome"
                      placeholder="Seu nome completo"
                      onkeyup="mTexto(this)"
                    />
                    <div class="invalid-feedback" id="erroNome"></div>
                  </div>

                  <!-- E-mail -->
                  <div class="col-md-6">
                    <label for="contatoEmail" class="form-label"
                      >E-mail *</label
                    >
                    <input
                      type="email"
                      class="form-control"
                      id="contatoEmail"
                      placeholder="seu@email.com"
                      onblur="validarEmail(this)"
                    />
                    <div class="invalid-feedback" id="erroEmail"></div>
                  </div>

                  <!-- Telefone -->
                  <div class="col-md-6">
                    <label for="contatoTelefone" class="form-label"
                      >Telefone *</label
                    >
                    <input
                      type="text"
                      class="form-control"
                      id="contatoTelefone"
                      placeholder="(18) 99999-9999"
                      onkeyup="mTel(this)"
                      maxlength="14"
                    />
                    <div class="invalid-feedback" id="erroTelefone"></div>
                  </div>

                  <!-- Categoria -->
                  <div class="col-md-6">
                    <label for="categoria" class="form-label"
                      >Categoria *</label
                    >
                    <select id="categoria" class="form-select">
                      <option value="" selected disabled>Selecione...</option>
                      <option>Dúvida</option>
                      <option>Pedido</option>
                      <option>Reclamação</option>
                      <option>Sugestão</option>
                      <option>Elogio</option>
                    </select>
                    <div class="invalid-feedback" id="erroCategoria"></div>
                  </div>

                  <!-- CPF -->
                  <div class="col-md-8">
                    <label for="CPF" class="form-label">CPF *</label>
                    <div class="d-flex gap-2">
                      <input
                        type="text"
                        class="form-control"
                        id="CPF"
                        placeholder="000.000.000-00"
                        onkeyup="mCpf(this)"
                        maxlength="14"
                      />
                      <button
                        type="button"
                        class="btn cf-btn"
                        onclick="verificarCPF()"
                      >
                        Validar
                      </button>
                    </div>
                    <div class="form-text" id="mensagemCPF"></div>
                  </div>

                  <!-- CEP -->
                  <div class="col-md-8">
                    <label for="CEP" class="form-label">CEP *</label>
                    <div class="d-flex gap-2">
                      <input
                        type="text"
                        class="form-control"
                        id="CEP"
                        placeholder="19000-000"
                        onkeyup="mCEP(this)"
                        maxlength="9"
                      />
                      <button
                        type="button"
                        class="btn cf-btn"
                        onclick="verificarCEP()"
                      >
                        Buscar
                      </button>
                    </div>
                    <div class="form-text" id="mensagemCEP"></div>
                  </div>

                  <!-- Horário -->
                  <div class="col-md-4">
                    <label for="horario" class="form-label"
                      >Melhor horário</label
                    >
                    <select id="horario" class="form-select">
                      <option>Manhã</option>
                      <option>Tarde</option>
                      <option>Noite</option>
                    </select>
                  </div>

                  <!-- Mensagem -->
                  <div class="col-12">
                    <label for="contatoMensagem" class="form-label"
                      >Mensagem *</label
                    >
                    <textarea
                      id="contatoMensagem"
                      class="form-control"
                      rows="4"
                      placeholder="Escreva sua mensagem..."
                    ></textarea>
                    <div class="invalid-feedback" id="erroMensagem"></div>
                  </div>

                  <!-- Submit -->
                  <div class="col-12">
                    <button type="submit" class="btn cf-btn w-100">
                      <i></i>Enviar mensagem
                    </button>
                  </div>

                  <!-- Alerta de sucesso -->
                  <div class="col-12">
                    <div
                      id="alertaSucesso"
                      class="alert alert-success d-none"
                      role="alert"
                    >
                      <i class="fa-solid fa-circle-check me-2"></i>
                      Mensagem enviada com sucesso! Entraremos em contato em
                      breve.
                    </div>
                  </div>
                </div>
              </form>
            </div>
          </div>

          <!-- SIDEBAR INFO -->
          <div class="col-lg-5">
            <div class="cf-card p-3 mb-3 cf-anim" data-delay="100">
              <h6 class="mb-3">Informações</h6>
              <p class="mb-1">
                <i class="fa-solid fa-phone me-2"></i>(18) 4002-8922
              </p>
              <p class="mb-1">
                <i class="fa-solid fa-envelope me-2"></i
                >cortefinoprimary@gmail.com
              </p>
              <p class="mb-0">
                <i class="fa-solid fa-location-dot me-2"></i>Presidente Prudente
                - SP
              </p>
            </div>

            <div class="cf-whats text-center mb-3 cf-anim" data-delay="200">
              <h6>Atendimento rápido</h6>
              <p class="small mb-3">Fale conosco direto no WhatsApp</p>
              <a
                href="https://wa.me/5518997732006?text=Ola%20Corte%20Fino,%20gostaria%20de%20solicitar%20atendimento%20rapido."
                class="btn btn-success w-100"
              >
                <i class="fa-brands fa-whatsapp me-2"></i>WhatsApp
              </a>
            </div>

            <div class="cf-card p-2 cf-anim" data-delay="300">
              <h6 class="p-2">Localização</h6>
              <iframe
                src="https://maps.google.com/maps?q=Presidente%20Prudente&t=&z=13&ie=UTF8&iwloc=&output=embed"
                width="100%"
                height="200"
                style="border: 0"
                loading="lazy"
              >
              </iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- RODAPÉ -->
    <%- include("partials/footer", { footerType: "contact" }) %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/JS/scripts/contato.js"></script>
  </body>
</html>
