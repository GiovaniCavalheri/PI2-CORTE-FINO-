<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Corte Fino - Açougue Gourmet</title>

    <!-- BOOTSTRAP CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <!-- FAVICON -->
    <link rel="shortcut icon" href="/images/icon-Corte-Fino.ico" />

    <!-- ICONES -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
    />

    <link
      href="https://cdn.jsdelivr.net/npm/remixicon/fonts/remixicon.css"
      rel="stylesheet"
    />

    <!-- FONTE -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- CSS (PADRÃO DO INDEX) -->
    
    <link rel="stylesheet" href="/CSS/style.css" />
  </head>
  <body>
    <!-- HEADER TOP - Informações de contato -->
    <div class="header-top py-2">
      <div class="container d-flex justify-content-end gap-3">
        <span><i class="fas fa-phone"></i> (18) 4002-8922</span>
        <span class="divisor">|</span>
        <span
          ><i class="fa-solid fa-clock"></i> Seg-Sab: 7h-19h | Dom: 7h-13h</span
        >
      </div>
    </div>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg main-header sticky-top">
      <div class="container">
        <a class="navbar-brand logo-area" href="/">
          <img
            src="/images/logo-c-f.png"
            style="height: 60px"
            alt="Logo Corte Fino"
          />
          <span class="fs-3 fw-semibold">Corte Fino</span>
        </a>
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#menuPrincipal"
        >
          <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="menuPrincipal">
          <ul class="nav nav-pills ms-auto">
            <li class="nav-item">
              <a href="/" class="nav-link active" aria-current="page"
                >Início</a
              >
            </li>
            <li class="nav-item">
              <a href="/products" class="nav-link"
                >Produtos</a
              >
            </li>
            <li class="nav-item">
              <a href="/offers" class="nav-link">Ofertas</a>
            </li>
            <li class="nav-item">
              <a href="/about" class="nav-link">Sobre Nós</a>
            </li>
            <li class="nav-item">
              <a href="/services" class="nav-link"
                >Serviços</a
              >
            </li>
            <li class="nav-item">
              <a href="/contact" class="nav-link">Contato</a>
            </li>
            <li class="nav-item">
              <a href="/signatures" class="nav-link"
                >Assinaturas</a
              >
            </li>
            <li class="nav-item">
              <a href="/cart" class="nav-link">Carrinho</a>
            </li>
            <li class="nav-item">
              <a
                href="/join"
                class="nav-link destaque-vermelho"
                >Entrar</a
              >
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <!-- SEÇÃO PRODUTOS -->
    <main class="pagina-produtos">
      <!-- CABEÇALHO -->
      <section class="hero-section d-flex align-items-center">
        <div class="container">
          <h4 class="border-premium">Produtos</h4>
          <h2 class="h1 mb-3 text-white fw-bold">Nossos Produtos</h2>
          <p class="sub-hero col-12 col-md-7">
            Carnes selecionadas com certificação de qualidade e frescor
            garantido.
          </p>
        </div>
      </section>

      <!-- BARRA DE BUSCA -->
      <div class="container-busca mt-5">
        <span class="icone-busca"></span>
        <input
          type="text"
          class="campo-busca"
          placeholder="Buscar produtos..."
          id="busca"
        />
      </div>

      <!-- FILTROS -->
      <div class="botoes-filtro">
        <button class="botao-filtro ativo" data-categoria="todos">Todos</button>
        <button class="botao-filtro" data-categoria="bovino">Bovino</button>
        <button class="botao-filtro" data-categoria="suino">Suíno</button>
        <button class="botao-filtro" data-categoria="aves">Aves</button>
        <button class="botao-filtro" data-categoria="kits">
          Kits Especiais
        </button>
      </div>

      <!-- GRID - produtos vindos do banco de dados -->
      <section class="grid-produtos" id="listaProdutos">
        <% if (produtos.length == 0) { %>
        <p>Nenhum produto cadastrado no momento.</p>
        <% } %>

        <% for (let i = 0; i < produtos.length; i++) { %>
        <div class="cartao-produto">
          <div class="area-img-produto">
            <img
              src="/images/Cards-Produtos/picanha-bovina-card.png"
              class="img-produto"
              alt="<%= produtos[i].NOME_PRODUTO %>"
            />
          </div>

          <div class="info-produto">
            <span class="categoria-produto"><%= produtos[i].NOME_CATEGORIA %></span>
            <h3 class="nome-produto"><%= produtos[i].NOME_PRODUTO %></h3>
            <p class="descricao-produto"><%= produtos[i].DESCRICAO %></p>

            <div class="preco-produto">
              <span class="preco-atual">R$ <%= produtos[i].PRECO_VENDA %></span>
              <span class="unidade-preco">/kg</span>
            </div>

            <button class="btn-adicionar">Adicionar ao Pedido</button>
          </div>
        </div>
        <% } %>
      </section>
    </main>
    <!-- FOOTER -->
    <footer class="section-footer py-5">
      <div class="container">
        <div class="row g-4">
          <div class="col-12 col-sm-6 col-lg-3">
            <h2 class="fs-5 fw-bold mb-3">Corte Fino</h2>
            <p class="footer-text">
              Qualidade e Frescor premium em cada corte. Tradição e excelência
              desde 1995.
            </p>
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <h2 class="fs-5 fw-bold mb-3">Links Rápidos</h2>
            <ul class="list-unstyled footer-links">
              <li><a href="/products">Produtos</a></li>
              <li><a href="/offers">Ofertas</a></li>
              <li><a href="/about">Sobre Nós</a></li>
              <li><a href="/services">Serviços</a></li>
              <li><a href="/contact">Contato</a></li>
              <li><a href="/signatures">Assinaturas</a></li>
              <li>
                <a href="#logout"
                  ><i class="fa-solid fa-arrow-right-from-bracket"></i> Sair</a
                >
              </li>
            </ul>
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <h2 class="fs-5 fw-bold mb-3">Contato</h2>
            <p class="footer-text">
              <i class="fa-solid fa-phone me-2"></i>(18) 4002-8922
            </p>
            <p class="footer-text">
              <i class="fa-solid fa-envelope me-2"></i
              ><a href="mailto:cortefinoprimary@gmail.com"
                >cortefinoprimary@gmail.com</a
              >
            </p>
            <p class="footer-text">
              <i class="fa-solid fa-location-dot me-2"></i>Rua dos Girassois,
              124<br />Presidente Prudente - SP
            </p>
          </div>
          <div class="col-12 col-sm-6 col-lg-3">
            <h2 class="fs-5 fw-bold mb-3">Horário de Funcionamento</h2>
            <p class="footer-text">
              <i class="fa-solid fa-clock me-2"></i>Seg-Sáb: 7h às 19h<br />Domingo:
              7h às 13h
            </p>
            <p class="footer-text">
              <i class="fa-brands fa-instagram me-2"></i>Corte Fino
            </p>
          </div>
        </div>
        <hr class="footer-hr mt-4" />
        <p class="text-center footer-text mt-3 mb-0" style="font-size: 13px">
          © 2025 Açougue Corte Fino. Todos os direitos reservados.
        </p>
      </div>
    </footer>
    <script src="/JS/scripts/cart.js"></script>
    <script src="/JS/scripts/products.js" defer></script>
  </body>
</html>
